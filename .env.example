# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram
TELEGRAM_WEBHOOK_SECRET=your-random-secret-string

# Encryption key for bot tokens stored in businesses.telegram_bot_token (AES-256-CBC).
# Required: saving a bot token throws without it, and the webhook then has no token to use.
# Generate with: openssl rand -hex 32
# Do not rotate — tokens already in the database become undecryptable, and decryptToken
# silently falls back to treating the ciphertext as plaintext, so bots go quiet with no error.
BOT_TOKEN_ENCRYPTION_KEY=your-random-encryption-key

# AI
ANTHROPIC_API_KEY=your-anthropic-key

# YooKassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

# Cron (generate a random string, pass as ?secret= or x-cron-secret header)
CRON_SECRET=your-random-cron-secret

# Test payment simulation (remove in prod or leave empty to disable)
TEST_PAYMENT_SECRET=your-random-test-secret

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Platform monitoring (Богдан's bot + numeric Telegram ID)
PLATFORM_BOT_TOKEN=your-platform-bot-token
PLATFORM_CHAT_ID=your-numeric-telegram-id

# Redis (Upstash) — rate limiter; without this, falls back to in-memory
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
