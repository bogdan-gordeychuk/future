# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram
TELEGRAM_WEBHOOK_SECRET=your-random-secret-string

# AI
ANTHROPIC_API_KEY=your-anthropic-key

# YooKassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

# Cron (generate a random string, pass as ?secret= or x-cron-secret header)
CRON_SECRET=your-random-cron-secret

# Test payment simulation (remove in prod or leave empty to disable)
TEST_PAYMENT_SECRET=your-random-test-secret

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com


#  Проект VIKA — AI-powered Telegram-ассистент для записи клиентов.
#   Стек: Next.js 15 App Router, TypeScript, Tailwind, Supabase, GrammY, Claude Haiku.
#   Репозиторий: https://github.com/bogdan-gordeychuk/future

#   Правила работы:
#   1. Перед изменением — читай файл
#   2. Проверяй сборку: npm run build
#   3. Коммить с prefix: feat/fix/chore/docs
#   4. Не трогай .env.local, ROADMAP.md читай для контекста
#   5. Архитектура в CLAUDE.md